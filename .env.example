# Copy to .env for local development. On a deployed host, set these as
# environment variables in the platform dashboard — .env is gitignored and is
# never uploaded, which is the most common cause of a deploy returning 500 on
# every request (server/config.js throws at import if any of these are missing).

# TomTom — live speed/congestion, detail drawer only
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com

# NYC Open Data (Socrata) — automated traffic volume counts
NY_OPEN_DATA_APP_TOKEN=
NY_OPEN_DATA_BASE_URL=https://data.cityofnewyork.us/api/v3/views/7ym2-wayt/query.json
NYC_TRAFFIC_VOLUME_DATASET_ID=7ym2-wayt

# Open NY (NYSDOT) — statewide AADT
OPEN_NY_APP_TOKEN=
OPEN_NY_BASE_URL=https://data.ny.gov/api/v3/views/6amx-2pbv/query.json
OPEN_NY_AADT_DATASET_ID=6amx-2pbv

# 511NY — event feed, supplies the is_explained term in the priority formula
FIVE_ELEVEN_BASE_URL=https://511ny.org/api
FIVE_ELEVEN_API_KEY=

API_TIMEOUT_MS=15000

# --- Deployment ---
# Where the dataset/geocode caches are written. Point this at a mounted volume
# on a persistent host. Falls back to <project>/data, then the OS temp dir.
# DATA_DIR=/data

# Background geocode warmup. Defaults on when DATA_DIR is persistent, off when
# it isn't (serverless), since the process is killed after each response.
# ENABLE_GEOCODE_WARMUP=true

# How long cached datasets stay valid. The upstream AADT data is frozen at 2019
# and NYC counts update a handful of segments a year, so a long TTL is safe and
# makes restarts much faster. Default is 1 hour.
# DATASET_CACHE_TTL_MS=86400000
